# ============================================================
# Application Configuration
# ============================================================
APP_NAME=ChatbotMCP
APP_ENV=development
SECRET_KEY=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=

# ============================================================
# Database
# ============================================================
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=
POSTGRES_DB=chatbot_db
DATABASE_URL=postgresql+asyncpg://chatbot:@postgres:5432/chatbot_db

# ============================================================
# Redis
# ============================================================
REDIS_PASSWORD=
REDIS_URL=redis://:@redis:6379/0

# ============================================================
# LLM Providers
# ============================================================
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEFAULT_LLM_PROVIDER=groq
DEFAULT_MODEL=llama-3.3-70b-versatile

# ============================================================
# Groq (free, fast API — get key at console.groq.com)
# ============================================================
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ============================================================
# Ollama (local open-source LLM — runs on your machine)
# ============================================================
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# ============================================================
# Gmail OAuth (Google Cloud Console)
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/oauth/gmail/callback
GMAIL_MCP_URL=http://gmail-mcp:8001
GMAIL_MCP_PORT=8001

# ============================================================
# Outlook OAuth (Microsoft Entra ID)
# ============================================================
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=common
AZURE_REDIRECT_URI=http://localhost:8002/oauth/outlook/callback
OUTLOOK_MCP_URL=http://outlook-mcp:8002
OUTLOOK_MCP_PORT=8002

# ============================================================
# Backend
# ============================================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:80"]
LOG_LEVEL=INFO

# ============================================================
# Frontend
# ============================================================
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME=ChatbotMCP
NEXT_PUBLIC_GMAIL_MCP_URL=http://localhost:8001
NEXT_PUBLIC_OUTLOOK_MCP_URL=http://localhost:8002

# ============================================================
# Security
# ============================================================
RATE_LIMIT_PER_MINUTE=60
MAX_CONVERSATION_LENGTH=100
MAX_TOOL_CALLS_PER_TURN=10
TOKEN_ENCRYPTION_KEY=
